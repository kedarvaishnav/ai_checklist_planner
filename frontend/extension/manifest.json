{
  "manifest_version": 3,
  "name": "AI Checklist Planner",
  "version": "1.0.0",
  "description": "Turn any page or selection into a checklist.",
  "action": {
    "default_title": "Open checklist panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "__API_ORIGIN__/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
