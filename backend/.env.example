# Copy this file to .env for local development
# Never commit .env to git

# PostgreSQL connection string
# For local development, replace the password and database name as needed.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/checklist_db
# Test database connection string (used by npm test, must not equal DATABASE_URL)
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/checklist_test_db

# Secret key used to sign JWTs
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# FRONTEND_URL: comma-separated list of exact origins
FRONTEND_URL=http://localhost:5173

# Production DB SSL certificate validation (defaults to true; set to false only for self-signed certificates)
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Set to production on Render
NODE_ENV=development

# Google Gemini API key for AI generation
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-2.5-flash)
GEMINI_MODEL=

# Optional Gemini timeout in milliseconds (defaults to 60000)
GEMINI_TIMEOUT_MS=

